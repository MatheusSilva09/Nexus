ument.querySelectorAll('li.itemCarrT').forEach(product=>{totalProducts+=parseInt(product.querySelector('.qt-itens-car').value);const priceText=product.querySelector('.carrTlistpreco').innerText;amount+=Pushnews.cartRecovery.convertPriceTextToNumber(priceText)});document.querySelectorAll('#valorcupom').forEach(coupon=>{discountAmount+=Pushnews.cartRecovery.convertPriceTextToNumber(coupon.innerHTML)});IlabsPush.push(["trackConversion",{context:amount>0?{amount:Math.round(amount*100)/100,totalProducts,currency:'BRL'}:{}}])},3000)}},observeUrlChanges:function(){var previousUrl=location.href;var observer=new MutationObserver(function(mutations){if(location.href!==previousUrl&&''!==previousUrl){previousUrl=location.href;setTimeout(function(){Pushnews.cartRecovery.custom.init()},1500)}});observer.observe(document,{subtree:!0,childList:!0})},init:function(){Pushnews.cartRecovery.custom.monitorCart();Pushnews.cartRecovery.custom.monitorCheckout();if(!Pushnews.cartRecovery.isObserveUrlChangesInitialized){Pushnews.cartRecovery.custom.observeUrlChanges();Pushnews.cartRecovery.isObserveUrlChangesInitialized=!0}}},init:function(){Pushnews.cartRecovery.custom.init()}}

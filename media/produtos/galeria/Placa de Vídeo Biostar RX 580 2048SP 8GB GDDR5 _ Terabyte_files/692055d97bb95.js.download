  padding: 4px 12px 8px 12px;\n  font-style: italic;\n}\n\n.edrone-rle-empty {\n  border: 1px solid;\n  padding: 28px 20px;\n  text-align: center;\n  border-color: var(--edrone-rle-border, #e5e5e5);\n  background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);\n}\n\n.edrone-rle-empty-title {\n  margin: 0 0 8px;\n  font-size: 18px;\n  font-weight: 700;\n}\n\n.edrone-rle-empty-description {\n  margin: 0;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.edrone-rle-load-more-wrap {\n  display: flex;\n  justify-content: center;\n  margin-top: 18px;\n}\n\n.edrone-rle-load-more {\n  appearance: none;\n  border: none;\n  padding: 12px 18px;\n  border-radius: 999px;\n  cursor: pointer;\n  font-size: 13px;\n  font-weight: 700;\n  box-shadow: 0 8px 18px rgba(5, 5, 5, 0.14);\n}\n\n.edrone-rle-load-more:disabled {\n  cursor: default;\n  opacity: 0.6;\n}\n\n.edrone-review-list-embed[data-surface-mode="section"]\n  .edrone-rle-load-more-wrap {\n  margin-top: 22px;\n}\n\n.edrone-review-list-embed[data-width-tier="wide"] .edrone-rle-title,\n.edrone-review-list-embed[data-width-tier="medium"] .edrone-rle-title {\n  font-size: 22px;\n}\n\n.edrone-review-list-embed[data-width-tier="wide"] .edrone-rle-summary,\n.edrone-review-list-embed[data-width-tier="medium"] .edrone-rle-summary,\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-summary,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-summary {\n  grid-template-columns: 1fr;\n  grid-template-areas:\n    "hero"\n    "stats"\n    "footer";\n  gap: 16px;\n  padding: 20px;\n}\n\n.edrone-review-list-embed[data-width-tier="wide"] .edrone-rle-summary-score,\n.edrone-review-list-embed[data-width-tier="medium"] .edrone-rle-summary-score,\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-summary-score,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-summary-score {\n  min-height: 140px;\n  padding: 18px;\n}\n\n.edrone-review-list-embed[data-width-tier="wide"] .edrone-rle-summary-stats,\n.edrone-review-list-embed[data-width-tier="medium"] .edrone-rle-summary-stats,\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-summary-stats,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-summary-stats {\n  padding: 16px;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-title,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-title {\n  font-size: 24px;\n  max-width: none;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-card,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-card {\n  padding: 16px;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-card-header {\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-verified {\n  align-self: flex-start;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-load-more-wrap,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-load-more-wrap {\n  display: block;\n}\n\n.edrone-review-list-embed[data-width-tier="compact"] .edrone-rle-load-more,\n.edrone-review-list-embed[data-width-tier="narrow"] .edrone-rle-load-more {\n  width: 100%;\n}\n\n@media (max-width: 767px) {\n  .edrone-rle-summary {\n    grid-template-columns: 1fr;\n    grid-template-areas:\n      "hero"\n      "stats"\n      "footer";\n    gap: 16px;\n    padding: 18px;\n  }\n\n  .edrone-rle-title {\n    max-width: none;\n    font-size: 22px;\n  }\n\n  .edrone-rle-summary-score {\n    min-height: auto;\n    padding: 18px;\n  }\n\n  .edrone-rle-summary-avg-value {\n    font-size: 46px;\n  }\n\n  .edrone-rle-summary-score-meta {\n    gap: 8px;\n  }\n\n  .edrone-rle-summary-avg-row {\n    gap: 10px;\n  }\n\n  .edrone-rle-summary-review-count {\n    min-height: 30px;\n    padding: 6px 10px;\n  }\n\n  .edrone-rle-summary-stats {\n    padding: 16px;\n  }\n\n  .edrone-rle-summary-stats-header {\n    align-items: center;\n  }\
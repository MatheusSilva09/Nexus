 5, 5, 0.06), 0 3px 10px rgba(5, 5, 5, 0.04);\n}\n\n.edrone-rle-summary-hero {\n  grid-area: hero;\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 14px;\n  min-width: 0;\n}\n\n.edrone-rle-summary-copy {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  min-width: 0;\n}\n\n.edrone-rle-title {\n  margin: 0;\n  max-width: 15ch;\n  font-size: 40px;\n  line-height: 0.98;\n  font-weight: 800;\n  letter-spacing: -0.05em;\n  color: #6b7280;\n}\n\n.edrone-rle-summary-avg-row {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  flex-wrap: wrap;\n}\n\n.edrone-rle-summary-score-meta {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.edrone-rle-summary-avg {\n  display: flex;\n  align-items: baseline;\n  gap: 4px;\n}\n\n.edrone-rle-summary-avg-value {\n  font-size: 60px;\n  line-height: 0.9;\n  font-weight: 800;\n  letter-spacing: -0.06em;\n}\n\n.edrone-rle-summary-avg-scale {\n  font-size: 18px;\n  line-height: 1;\n  font-weight: 600;\n  opacity: 0.5;\n}\n\n.edrone-rle-summary-stars {\n  display: inline-flex;\n  align-items: center;\n  line-height: 0;\n}\n\n.edrone-rle-summary-review-count {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 34px;\n  padding: 8px 12px;\n  border: 1px solid\n    color-mix(in srgb, var(--edrone-rle-border, #e5e7eb) 68%, transparent);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.72);\n  backdrop-filter: blur(10px);\n}\n\n.edrone-rle-summary-review-count {\n  font-size: 12px;\n  line-height: 1.4;\n  font-weight: 600;\n}\n\n.edrone-rle-summary-stats {\n  grid-area: stats;\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  align-self: start;\n  padding: 20px;\n  border: 1px solid\n    color-mix(in srgb, var(--edrone-rle-border, #e5e7eb) 68%, transparent);\n  border-radius: calc(var(--edrone-rle-radius, 12px) + 4px);\n  background: linear-gradient(\n    180deg,\n    rgba(255, 255, 255, 0.88) 0%,\n    color-mix(\n        in srgb,\n        var(--edrone-rle-card-bg, #ffffff) 82%,\n        var(--edrone-rle-bg, #f8f9fa)\n      )\n      100%\n  );\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.68);\n}\n\n.edrone-rle-summary-stats-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.edrone-rle-summary-stats-copy {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.edrone-rle-summary-panel-label {\n  font-size: 10px;\n  line-height: 1.2;\n  font-weight: 700;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n}\n\n.edrone-rle-distribution {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n}\n\n.edrone-rle-distribution-row {\n  display: grid;\n  grid-template-columns: 24px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 6px;\n  padding: 6px 10px;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.62);\n}\n\n.edrone-rle-distribution-star {\n  display: flex;\n  align-items: center;\n  gap: 2px;\n}\n\n.edrone-rle-distribution-star-icon {\n  width: 12px;\n  height: 12px;\n  flex-shrink: 0;\n}\n\n.edrone-rle-distribution-rating {\n  font-size: 12px;\n  line-height: 1;\n  font-weight: 700;\n}\n\n.edrone-rle-distribution-count {\n  min-width: 24px;\n  font-size: 12px;\n  line-height: 1.4;\n  text-align: right;\n  font-variant-numeric: tabular-nums;\n  font-weight: 600;\n}\n\n.edrone-rle-distribution-track {\n  height: 10px;\n  overflow: hidden;\n  border-radius: 999px;\n  background: rgba(148, 163, 184, 0.14);\n  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.06);\n  border: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.edrone-rle-distribution-fill {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  transition: width 0.4s ease;\n  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.25);\n  background-color: #ffff8c !important;\n}\n\n.edrone-rle-summary-footer {\n  grid-area: footer;\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n}\n\n.edrone-rle-summary-powered-by {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  border: 1px solid\n    color-mix(in srgb, var(--edrone-rle-border, #e5e7eb) 70%, transparent);\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.74);\n  color: color-mix(\n    in srgb,\n    var(--edrone-rle-text, #050505) 64%,\n    var(--edrone-rle-muted, #545454)\n  );\n  font-size: 11px;\n  line-height: 1;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.edrone-rle-summary-powered-by::before {\n  content: "";\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: linear-gradient(\n    135deg,\n    var(--edrone-rle-accent, #050505),\n    var(--edrone-rle-star, #ffff8c)\n  );\n  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.5);\n}\n\n.edrone-rle-grid {\n  display: grid;\n}\n\n.edrone-rle-grid[data-layout="list"] {\n  grid-template-columns: 1fr;\n}\n\n.edrone-rle-card {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  border: 1px solid;\n  padding: 20px;\n  border-color: var(--edrone-rle-border, #e5e5e5);\n  background: var(--edrone-rle-card-bg, #ffffff);\n  box-shadow: 0 2px 8px rgba(5, 5, 5, 0.04);\n  transition: box-shadow 0.2s ease, transform 0.2s ease;\n}\n\n.edrone-rle-card:hover {\n  box-shadow: 0 8px 20px rgba(5, 5, 5, 0.08);\n  transform: translateY(-1px);\n}\n\n.edrone-rle-card-header {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.edrone-rle-card-identity {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n}\n\n.edrone-rle-author {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 700;\n  color: var(--edrone-rle-text, #050505);\n}\n\n.edrone-rle-author--shop {\n  font-size: 17px;\n}\n\n.edrone-rle-verified {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 
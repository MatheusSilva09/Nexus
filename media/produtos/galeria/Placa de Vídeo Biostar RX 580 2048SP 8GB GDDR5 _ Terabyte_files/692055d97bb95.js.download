drone-star-rating-embed {\n  display: inline-flex;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n\n/* Entrance animations */\n.edrone-star-rating-embed.edrone-sre-loaded {\n  opacity: 1;\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-fade {\n  opacity: 0;\n  transition: opacity 0.4s ease;\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-fade.edrone-sre-loaded {\n  opacity: 1;\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-slideUp {\n  opacity: 0;\n  transform: translateY(8px);\n  transition: opacity 0.4s ease, transform 0.4s ease;\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-slideUp.edrone-sre-loaded {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-scale {\n  opacity: 0;\n  transform: scale(0.9);\n  transition: opacity 0.4s ease,\n    transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.edrone-star-rating-embed.edrone-sre-anim-scale.edrone-sre-loaded {\n  opacity: 1;\n  transform: scale(1);\n}\n\n/* Click behavior */\n.edrone-star-rating-embed.edrone-sre-clickable {\n  cursor: pointer;\n}\n\n.edrone-star-rating-embed.edrone-sre-clickable:hover {\n  opacity: 0.85;\n}\n\n/* Alignment */\n.edrone-star-rating-embed.edrone-sre-align-left {\n  justify-content: flex-start;\n}\n\n.edrone-star-rating-embed.edrone-sre-align-center {\n  justify-content: center;\n  display: flex;\n}\n\n.edrone-star-rating-embed.edrone-sre-align-right {\n  justify-content: flex-end;\n  display: flex;\n}\n\n/* Compact preset */\n.edrone-sre-compact,\n.edrone-sre-detailed {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  flex-wrap: nowrap;\n}\n\n/* Bar preset */\n.edrone-sre-bar {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.edrone-sre-bar-header {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.edrone-sre-bar-distribution {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  width: 100%;\n}\n\n.edrone-sre-bar-row {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n\n.edrone-sre-bar-label {\n  width: 24px;\n  text-align: right;\n  flex-shrink: 0;\n  font-size: 11px;\n}\n\n.edrone-sre-bar-track {\n  flex: 1;\n  height: 6px;\n  min-width: 60px;\n  overflow: hidden;\n  position: relative;\n}\n\n.edrone-sre-bar-fill {\n  height: 100%;\n  transition: width 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n}\n\n.edrone-sre-bar-value {\n  width: 20px;\n  text-align: left;\n  flex-shrink: 0;\n  font-size: 11px;\n}\n\n/* Numeric preset */\n.edrone-sre-numeric {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.edrone-sre-numeric-value {\n  font-weight: 800;\n  line-height: 1;\n  letter-spacing: -0.02em;\n}\n\n.edrone-sre-numeric-details {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n/* Score (circular gauge) preset */\n.edrone-sre-score {\n  display: inline-flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.edrone-sre-score-circle {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.edrone-sre-score-circle svg circle:last-child {\n  transition: stroke-dashoffset 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);\n}\n\n.edrone-sre-score-value {\n  position: absolute;\n  font-weight: 700;\n}\n\n.edrone-sre-score-details {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n/* Common text styles */\n.edrone-sre-count {\n  white-space: nowrap;\n}\n\n.edrone-sre-average {\n  white-space: nowrap;\n}\n\n/* Star container */\n.EdroneReviewsStars {\n  display: inline-flex;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n/* Star hover micro-interaction */\n.edrone-sre-clickable .EdroneReviewsStars svg {\n  transition: transform 0.15s ease;\n}\n\n.edrone-sre-clickable:hover .EdroneReviewsStars svg {\n  transform: scale(1.08);\n}\n\n/* Star fill animation */\n@keyframes sre-star-fill {\n  0% {\n    clip-path: inset(0 100% 0 0);\n  }\n  100% {\n    clip-path: inset(0 0 0 0);\n  }\n}\n"},TcQ7:function(e,n,t){var r=t("MU5D"),o=t("52gC");e.exports=function(e)